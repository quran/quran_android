  <color name="reading_bookmark_page_purple">#ff6a1b9a</color>
  <color name="reading_bookmark_page_brown">#ff6d4c41</color>
  <color name="reading_bookmark_page_grey">#ff546e7a</color>
  <color name="reading_bookmark_page_teal_night">#ff4db6ac</color>
  <color name="reading_bookmark_page_orange_night">#ffffb74d</color>
  <color name="reading_bookmark_page_red_night">#ffe57373</color>
