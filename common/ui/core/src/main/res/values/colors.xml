<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!--
    the pale colors a highlighted ayah is painted with on the page. these are the same values as
    the Color literals in HighlightColors, which pairs each one with the resource below - keep the
    two in sync. lists use the darker highlight_list_* ramp instead, since these are too weak to
    read against a light row.
  -->
  <color name="highlight_page_yellow">#FFFDEC63</color>
  <color name="highlight_page_green">#FFC1EC71</color>
  <color name="highlight_page_blue">#FFADD7FE</color>
  <color name="highlight_page_pink">#FFFEB0CA</color>
  <color name="highlight_page_purple">#FFD8B1FE</color>
  <!--
    the color each reading bookmark slot's pin is drawn in (the first three sync; the others are kept on
    the device). paired with the slot names below by
    ReadingBookmarkSlots; the night variant lives in values-night/colors.xml.
  -->
  <color name="reading_bookmark_teal">#ff00897b</color>
  <color name="reading_bookmark_orange">#ffef6c00</color>
  <color name="reading_bookmark_red">#ffc62828</color>
  <color name="reading_bookmark_green">#ff2e7d32</color>
  <color name="reading_bookmark_blue">#ff1565c0</color>
  <color name="reading_bookmark_purple">#ff6a1b9a</color>
  <color name="reading_bookmark_brown">#ff6d4c41</color>
  <color name="reading_bookmark_grey">#ff546e7a</color>
  <!--
    the same slot colors for underlines on image pages, which follow the page's night mode rather
    than the app theme, so neither set is overridden in values-night.
  -->
  <color name="reading_bookmark_page_teal">#ff00897b</color>
  <color name="reading_bookmark_page_orange">#ffef6c00</color>
