<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/quran_row_background"
    android:orientation="vertical">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:minHeight="70dp"
      android:paddingStart="16dp"
      android:paddingEnd="16dp"
      android:orientation="horizontal">

    <TextView
        android:id="@+id/suraNumber"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="14dp"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:background="@drawable/sura_number_badge"
        android:fontFamily="sans-serif-medium"
        android:textColor="?attr/quranSuraNumberText"
        android:textSize="15sp"
        tools:text="23" />

    <ImageView
        android:id="@+id/rowIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="14dp"
        android:layout_gravity="center_vertical"
        android:scaleType="centerInside"
        android:visibility="gone"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_gravity="center_vertical"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:orientation="vertical">

      <TextView
          android:id="@+id/title"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="3dp"
          android:ellipsize="end"
          android:gravity="start"
          android:scrollHorizontally="true"
          android:textAppearance="@style/TitleText"
          tools:text="البقرة" />

      <TextView
          android:id="@+id/metadata"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:gravity="start"
          android:textColor="?attr/quranTextSecondary"
          android:textSize="13.5sp"
          tools:text="مدنية - 286 آية" />

      <com.quran.labs.androidquran.view.TagsViewGroup
          android:id="@+id/tags"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_gravity="start"
          android:layout_marginTop="4dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/pageNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_gravity="center_vertical"
        android:fontFamily="sans-serif-medium"
        android:textColor="?attr/quranTextSecondary"
        android:textSize="14sp"
        tools:text="1" />
  </LinearLayout>

  <View
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:layout_marginStart="70dp"
      android:layout_marginEnd="16dp"
      android:background="?attr/quranDivider" />
</LinearLayout>
