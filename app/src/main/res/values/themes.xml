<?xml version="1.0" encoding="utf-8"?>
<resources>

  <style name="Quran" parent="Theme.AppCompat">
    <item name="colorAccent">@color/accent_color</item>
    <item name="spinnerStyle">?attr/actionDropDownStyle</item>
    <item name="spinnerDropDownItemStyle">@style/SherlockDropDownItem</item>
    <item name="spinnerItemStyle">@style/SherlockSpinnerItem</item>
  </style>

  <style name="QuranToolBar" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:windowBackground">@color/surface</item>
    <item name="colorAccent">@color/accent_color</item>
    <item name="windowActionModeOverlay">true</item>
    <item name="spinnerStyle">?attr/actionDropDownStyle</item>
    <item name="spinnerDropDownItemStyle">@style/SherlockDropDownItem</item>
    <item name="spinnerItemStyle">@style/SherlockSpinnerItem</item>
  </style>

  <style name="QuranToolBarDayNight" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:windowBackground">@color/surface</item>
    <item name="actionModeBackground">@color/toolbar</item>
    <item name="colorAccent">@color/accent_color</item>
    <item name="colorPrimary">@color/toolbar</item>
    <item name="iconTint">@color/icon_tint</item>
    <item name="windowActionModeOverlay">true</item>
    <item name="spinnerStyle">?attr/actionDropDownStyle</item>
    <item name="spinnerDropDownItemStyle">@style/SherlockDropDownItem</item>
    <item name="spinnerItemStyle">@style/SherlockSpinnerItem</item>
  </style>

  <style name="QuranToolBarActionButton" parent="Widget.AppCompat.ActionButton">
    <item name="android:tint">@color/icon_tint</item>
  </style>

  <style name="QuranToolBar.Overlay">
    <item name="windowActionBarOverlay">true</item>
    <item name="android:statusBarColor">@color/toolbar</item>
    <item name="android:navigationBarColor">@color/toolbar</item>
    <item name="actionButtonStyle">@style/QuranToolBarActionButton</item>
    <item name="actionModeCloseButtonStyle">@style/QuranToolBarActionButton</item>
  </style>

    <style name="QuranDialog" parent="Theme.AppCompat.DayNight.Dialog" />

    <style name="Quran.BottomSheetDialog" parent="Theme.MaterialComponents.DayNight.BottomSheetDialog">
        <item name="colorPrimary">@color/accent_color</item>
        <item name="colorSecondary">@color/accent_color</item>
        <item name="colorAccent">@color/accent_color</item>
        <item name="colorControlActivated">@color/accent_color</item>
        <item name="colorSurface">@color/surface</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="enableEdgeToEdge">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="bottomSheetStyle">@style/Quran.BottomSheet</item>
    </style>

    <style name="Quran.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface</item>
        <item name="paddingBottomSystemWindowInsets">false</item>
        <item name="shapeAppearanceOverlay">@style/Quran.BottomSheet.Shape</item>
        <item name="shouldRemoveExpandedCorners">false</item>
    </style>

    <style name="Quran.BottomSheet.Shape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
