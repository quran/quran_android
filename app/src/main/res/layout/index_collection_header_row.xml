<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:paddingStart="16dp"
    android:paddingEnd="0dp"
    android:gravity="center_vertical"
    android:background="@drawable/list_header_background"
    android:orientation="horizontal">

  <ImageView
      android:id="@+id/expandIcon"
      android:layout_width="20dp"
      android:layout_height="20dp"
      android:scaleType="fitCenter"
      android:src="@drawable/ic_expand_less_24"
      android:contentDescription="@string/collapse_collection" />

  <TextView
      android:id="@+id/title"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:layout_marginStart="8dp"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="@color/header_text_color"
      android:textSize="16sp"
      tools:text="Ramadan goals" />

  <TextView
      android:id="@+id/pageNumber"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:textColor="@color/header_text_color"
      android:textSize="14sp"
      tools:text="8" />

  <ImageView
      android:id="@+id/openIcon"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:scaleType="center"
      android:background="@drawable/transparent_row_ripple"
      android:src="@drawable/ic_chevron_right_24"
      android:contentDescription="@string/open_collection" />
</LinearLayout>
