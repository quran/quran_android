<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/quranSurface"
    android:orientation="vertical">

  <LinearLayout
      android:id="@+id/toolbar_area"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:background="?attr/quranToolbarBackground">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        style="@style/ToolBarArea"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:theme="@style/ToolbarStyle"
        app:popupTheme="?attr/quranPopupTheme"
        app:subtitleTextAppearance="@style/ToolbarSubtitleText"
        app:titleTextAppearance="@style/ToolbarTitleText" />

    <com.quran.labs.androidquran.view.SlidingTabLayout
        android:id="@+id/indicator"
        style="@style/ToolBarArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <View
        android:id="@+id/toolbar_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/quranDivider" />
  </LinearLayout>

  <com.quran.labs.androidquran.view.QuranViewPager
      android:id="@+id/index_pager"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1" />

  <View
      android:id="@+id/nav_bar_divider"
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:background="?attr/quranDivider"
      android:visibility="gone" />

  <View
      android:id="@+id/nav_bar_scrim"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:background="?attr/quranToolbarBackground" />
</LinearLayout>
